{
  "name": "shkoli-bg-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:seo": "npm run seo:sync-content && npm run seo:generate && npm run build && npm run seo:prerender && npm run seo:validate",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "npm run build:seo && playwright test",
    "test:e2e:ci": "playwright test",
    "seo:sync-content": "tsx seo.sync-content.ts",
    "seo:generate": "tsx seo.generate.ts",
    "seo:validate": "tsx seo.validate.ts",
    "seo:prerender": "tsx seo.prerender.ts",
    "perf:budget": "tsx perf.budget.ts",
    "perf": "lhci autorun",
    "security": "npm audit --omit=dev --audit-level=high",
    "preview": "vite preview"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity": "3.893.0",
    "@aws-sdk/client-s3": "3.893.0",
    "@aws-sdk/credential-provider-cognito-identity": "3.893.0",
    "@aws-sdk/lib-storage": "3.893.0",
    "@hookform/resolvers": "^3.9.1",
    "@sentry/react": "^10.38.0",
    "@tanstack/react-query": "^5.64.0",
    "axios": "^1.7.7",
    "i18next": "^23.12.1",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-hook-form": "^7.53.2",
    "react-i18next": "^15.0.2",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.30.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@eslint/js": "^9.38.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.57.0",
    "@testing-library/react": "^16.3.1",
    "@types/node": "^24.9.1",
    "@types/leaflet": "^1.9.21",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitest/coverage-v8": "^4.0.18",
    "autoprefixer": "^10.4.20",
    "axe-core": "^4.11.0",
    "eslint": "^9.38.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.4.0",
    "jsdom": "^27.4.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.2",
    "tsx": "^4.20.6",
    "vite": "^7.1.12",
    "vitest": "^4.0.16"
  },
  "overrides": {
    "fast-xml-parser": "5.3.6",
    "qs": "6.15.0",
    "tmp": "^0.2.5"
  }
}
